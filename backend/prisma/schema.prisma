datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
  DRIVER
  FLEET_OWNER
  PLANT_OWNER
  BROKER
}

enum BookingStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTE_PREPARED
  CUSTOMER_ACCEPTED
  BOOKING_CONFIRMED
  DRIVER_SEARCHING
  DRIVER_APPLIED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED_PICKUP
  PICKUP_SCHEDULED
  PICKUP_ARRIVED
  LOADING
  PICKED_UP
  IN_TRANSIT
  ARRIVED_DESTINATION
  DELIVERED
  POD_UPLOADED
  POD_VERIFIED
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
  FAILED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum CommissionType {
  PLATFORM_FEE
  BROKER_FEE
  REFERRAL
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ==========================================
// USERS & ROLES
// ==========================================

model User {
  id          String   @id @default(uuid())
  uuid        String   @unique @default(uuid())
  email       String   @unique
  password    String
  role        UserRole
  status      String   @default("ACTIVE")
  is_verified Boolean  @default(false)
  last_login  DateTime?

  first_name  String?
  last_name   String?
  phone       String?
  avatar      String?
  bank_details Json?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  String?

  // Relations
  customer    Customer?
  driver      Driver?
  fleet_owner FleetOwner?
  plant_owner PlantOwner?
  broker      Broker?
  admin       Admin?
  wallets     Wallet[]
  audit_logs  ActivityLog[]
  approved_drivers  DriverApproval[] @relation("ApprovedByUser")
  driver_status_history DriverStatusHistory[] @relation("StatusChangedByUser")

  @@map("users")
}

model Customer {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id])
  company_name String?
  tax_number   String?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  deleted_at   DateTime?
  deleted_by   String?

  bookings     Booking[]
  invoices     Invoice[]

  @@map("customers")
}

model Driver {
  id          String   @id @default(uuid())
  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [id])
  status      String   @default("AVAILABLE")
  license     String?  @unique
  pdp         String?
  id_document String?
  fleet_owner_id String?
  fleet_owner FleetOwner? @relation(fields: [fleet_owner_id], references: [id])
  assigned_vehicle_id String?
  assigned_vehicle Vehicle? @relation(fields: [assigned_vehicle_id], references: [id])
  license_expiry DateTime?
  driving_category String?
  national_id String?
  address String?
  emergency_contact Json?
  documents Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  String?

  applications DriverApplication[]
  assignments BookingAssignment[]
  profile            DriverProfile?
  photos             DriverPhoto?
  documents_relation DriverDocuments?
  vehicle_relation   DriverVehicle?
  kyc                DriverKYC?
  approval           DriverApproval?
  status_history     DriverStatusHistory[]

  @@map("drivers")
}

model FleetOwner {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id])
  company_name String?
  status       String   @default("REGISTERED")
  company_documents Json?
  
  // Additional fleet details
  vat_number   String?
  num_vehicles Int?
  fleet_tier   String?
  operating_areas String?
  services_offered String?
  notes        String?
  address      String?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  deleted_at   DateTime?
  deleted_by   String?

  vehicles     Vehicle[]
  drivers      Driver[]
  assignments  BookingAssignment[]

  @@map("fleet_owners")
}

model PlantOwner {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id])
  company_name String?
  status       String   @default("REGISTERED")
  company_documents Json?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  deleted_at   DateTime?
  deleted_by   String?

  machines     Machine[]
  operators    MachineOperator[]
  hire_requests HireRequest[]
  assignments  BookingAssignment[]

  @@map("plant_owners")
}

model Broker {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id])
  company_name String?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  deleted_at   DateTime?
  deleted_by   String?

  assignments  BookingAssignment[]

  @@map("brokers")
}

model Machine {
  id                  String   @id @default(uuid())
  plant_owner_id      String
  plant_owner         PlantOwner @relation(fields: [plant_owner_id], references: [id])
  type                String
  capacity            Float?
  registration_number String   @unique
  status              String   @default("CREATED")
  machine_documents   Json?

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  is_deleted          Boolean  @default(false)

  assignments         BookingAssignment[]

  @@map("machines")
}

model MachineOperator {
  id              String   @id @default(uuid())
  plant_owner_id  String
  plant_owner     PlantOwner @relation(fields: [plant_owner_id], references: [id])
  name            String
  license         String   @unique
  status          String   @default("REGISTERED")

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  is_deleted      Boolean  @default(false)

  assignments     BookingAssignment[]

  @@map("machine_operators")
}

model HireRequest {
  id             String   @id @default(uuid())
  booking_id     String
  booking        Booking  @relation(fields: [booking_id], references: [id])
  plant_owner_id String
  plant_owner    PlantOwner @relation(fields: [plant_owner_id], references: [id])
  status         String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  requested_by   String?  // usually the Broker

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("hire_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String   // e.g., 'PlantOwner', 'Machine'
  entity_id   String
  action      String   // e.g., 'STATUS_UPDATE', 'APPROVED'
  old_value   String?
  new_value   String?
  actor_id    String?  // Admin User ID who did it
  created_at  DateTime @default(now())

  @@map("audit_logs")
}

model Admin {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id])

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  deleted_at   DateTime?
  deleted_by   String?

  @@map("admins")
}

// ==========================================
// VEHICLES
// ==========================================

model VehicleCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  String?

  vehicles    Vehicle[]

  @@map("vehicle_categories")
}

model Vehicle {
  id                      String           @id @default(uuid())
  fleet_owner_id          String
  fleet_owner             FleetOwner       @relation(fields: [fleet_owner_id], references: [id])
  category_id             String?
  category                VehicleCategory? @relation(fields: [category_id], references: [id])
  
  registration_number     String          @unique
  vehicle_type            String
  capacity                Float?
  status                  String          @default("REGISTERED")

  // Photo & identity
  photo_url               String?
  brand                   String?
  model                   String?
  year                    Int?
  vin                     String?         @unique

  // Compliance dates
  insurance_expiry        DateTime?
  fitness_expiry          DateTime?

  // Document URLs
  insurance_document      String?
  registration_document   String?
  fitness_document        String?

  // Legacy JSON docs field (kept for backward compat)
  vehicle_documents       Json?

  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  is_deleted              Boolean         @default(false)
  deleted_at              DateTime?
  deleted_by              String?

  assignments             BookingAssignment[]
  assigned_drivers        Driver[]

  @@map("vehicles")
}

// ==========================================
// BOOKINGS & QUOTES
// ==========================================

model Booking {
  id                 String   @id @default(uuid())
  
  // Optional for Guests
  customer_id        String?
  customer           Customer? @relation(fields: [customer_id], references: [id])
  guest_email        String?
  guest_phone        String?
  guest_company      String?

  // Step 1: Cargo
  cargo_name         String
  cargo_category     String
  description        String?  @db.Text
  weight             Float
  volume             Float?
  quantity           Int?

  // Step 2 & 3: Logistics
  pickup_address     String
  pickup_coords_lat  Float?
  pickup_coords_lng  Float?
  pickup_date        DateTime
  pickup_contact     String?
  pickup_instructions String? @db.Text

  delivery_address   String
  delivery_coords_lat Float?
  delivery_coords_lng Float?
  delivery_date      DateTime
  delivery_contact   String?
  delivery_instructions String? @db.Text

  // Step 4: Vehicle requested
  requested_vehicle  String?
  estimated_distance Float?

  status             BookingStatus @default(DRAFT)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  is_deleted         Boolean  @default(false)
  deleted_at         DateTime?
  deleted_by         String?

  requirements       BookingRequirement[]
  documents          BookingDocument[]
  quotes             Quote[]
  applications       DriverApplication[]
  assignments        BookingAssignment[]
  hire_requests      HireRequest[]
  trackings          TrackingHistory[]
  invoices           Invoice[]

  @@index([status])
  @@map("bookings")
}

model BookingRequirement {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id])
  tag        String   // e.g., "INSURANCE", "FRAGILE", "HELPERS_REQUIRED"
  value      String?  // Optional associated value (e.g., "2" helpers)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("booking_requirements")
}

model BookingDocument {
  id            String   @id @default(uuid())
  booking_id    String
  booking       Booking  @relation(fields: [booking_id], references: [id])
  document_type String   // INVOICE, PACKING_LIST, IMAGE, POD
  file_url      String
  uploaded_by   String?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_deleted    Boolean  @default(false)
  deleted_at    DateTime?
  deleted_by    String?

  @@map("booking_documents")
}

model Quote {
  id               String   @id @default(uuid())
  booking_id       String
  booking          Booking  @relation(fields: [booking_id], references: [id])
  
  distance_cost    Decimal  @db.Decimal(10,2) @default(0)
  vehicle_rate     Decimal  @db.Decimal(10,2) @default(0)
  weight_charges   Decimal  @db.Decimal(10,2) @default(0)
  fuel_charges     Decimal  @db.Decimal(10,2) @default(0)
  insurance_charges Decimal @db.Decimal(10,2) @default(0)
  hazard_charge    Decimal  @db.Decimal(10,2) @default(0)
  platform_fee     Decimal  @db.Decimal(10,2) @default(0)
  broker_fee       Decimal  @db.Decimal(10,2) @default(0)
  tax              Decimal  @db.Decimal(10,2) @default(0)
  discount         Decimal  @db.Decimal(10,2) @default(0)
  grand_total      Decimal  @db.Decimal(10,2)
  
  status           QuoteStatus @default(DRAFT)
  valid_until      DateTime?
  prepared_by      String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Boolean  @default(false)
  deleted_at       DateTime?
  deleted_by       String?

  @@map("quotes")
}

model BookingAssignment {
  id             String     @id @default(uuid())
  booking_id     String
  booking        Booking    @relation(fields: [booking_id], references: [id])
  
  driver_id      String?
  driver         Driver?    @relation(fields: [driver_id], references: [id])
  fleet_owner_id String?
  fleet_owner    FleetOwner? @relation(fields: [fleet_owner_id], references: [id])
  broker_id      String?
  broker         Broker?    @relation(fields: [broker_id], references: [id])
  vehicle_id     String?
  vehicle        Vehicle?   @relation(fields: [vehicle_id], references: [id])

  plant_owner_id String?
  plant_owner    PlantOwner? @relation(fields: [plant_owner_id], references: [id])
  machine_id     String?
  machine        Machine?    @relation(fields: [machine_id], references: [id])
  operator_id    String?
  operator       MachineOperator? @relation(fields: [operator_id], references: [id])

  status         String     @default("ACTIVE")
  assigned_by    String?

  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  is_deleted     Boolean    @default(false)
  deleted_at     DateTime?
  deleted_by     String?

  @@map("booking_assignments")
}

// ==========================================
// INVOICING & PAYMENTS
// ==========================================

model Invoice {
  id            String   @id @default(uuid())
  invoice_no    String   @unique
  booking_id    String
  booking       Booking  @relation(fields: [booking_id], references: [id])
  customer_id   String
  customer      Customer @relation(fields: [customer_id], references: [id])
  
  amount        Decimal  @db.Decimal(10,2)
  tax_amount    Decimal  @db.Decimal(10,2)
  total_amount  Decimal  @db.Decimal(10,2)
  due_date      DateTime?
  status        InvoiceStatus @default(DRAFT)
  file_url      String?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_deleted    Boolean  @default(false)
  deleted_at    DateTime?
  deleted_by    String?

  payments      Payment[]

  @@map("invoices")
}

model Payment {
  id             String   @id @default(uuid())
  invoice_id     String
  invoice        Invoice  @relation(fields: [invoice_id], references: [id])
  
  amount         Decimal  @db.Decimal(10,2)
  payment_method String?  // CARD, EFT, CASH
  transaction_id String?  @unique
  status         PaymentStatus @default(PENDING)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  is_deleted     Boolean  @default(false)
  deleted_at     DateTime?
  deleted_by     String?

  @@map("payments")
}

// ==========================================
// WALLETS & COMMISSIONS
// ==========================================

model Wallet {
  id                   String   @id @default(uuid())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id])
  
  balance              Decimal  @default(0) @db.Decimal(10,2)
  pending_balance      Decimal  @default(0) @db.Decimal(10,2)

  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  is_deleted           Boolean  @default(false)
  deleted_at           DateTime?
  deleted_by           String?

  transactions         WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  wallet_id     String
  wallet        Wallet   @relation(fields: [wallet_id], references: [id])
  
  type          TransactionType
  amount        Decimal  @db.Decimal(10,2)
  description   String?
  reference_id  String?  // Can link to Booking, Payment, Commission etc.
  status        String   @default("COMPLETED")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("wallet_transactions")
}

model Commission {
  id               String   @id @default(uuid())
  reference_type   String   // e.g., "BOOKING"
  reference_id     String
  earned_by_user_id String  // The Broker, Platform, or Fleet
  
  commission_type  CommissionType
  amount           Decimal  @db.Decimal(10,2)
  status           String   @default("PENDING")

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Boolean  @default(false)
  deleted_at       DateTime?
  deleted_by       String?

  @@map("commissions")
}

// ==========================================
// TRACKING & ACTIVITY
// ==========================================

model TrackingHistory {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id])
  
  status     BookingStatus
  lat        Float?
  lng        Float?
  remarks    String?  @db.Text
  updated_by String?  // User ID or "SYSTEM"
  
  timestamp  DateTime @default(now())

  @@map("tracking_history")
}

model ActivityLog {
  id          String   @id @default(uuid())
  user_id     String?
  user        User?    @relation(fields: [user_id], references: [id])
  
  action      String
  description String?  @db.Text
  ip_address  String?
  
  created_at  DateTime @default(now())

  @@map("activity_logs")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id               String   @id @default(uuid())
  recipient_id     String?  // Optional if sent to guest (email/phone)
  recipient_email  String?
  recipient_phone  String?
  
  type             NotificationType
  title            String?
  content          String   @db.Text
  status           NotificationStatus @default(PENDING)
  
  error_message    String?  @db.Text

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("notifications")
}


model DriverApplication {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id])
  driver_id  String
  driver     Driver   @relation(fields: [driver_id], references: [id])
  status     String   @default("APPLIED")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("driver_applications")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model PlantOwnerApplication {
  id                    String   @id @default(uuid())
  company_name          String
  contact_name          String
  email                 String
  phone                 String
  password              String?
  national_id           String
  equipment_type        String
  make                  String?
  model                 String?
  registration_number   String
  year                  Int?
  base_location         String
  company_reg_doc       String?
  machine_photo         String?
  status                String   @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  rejection_reason      String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("plant_owner_applications")
}

model DriverProfile {
  id                String    @id @default(uuid())
  driver_id         String    @unique
  driver            Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  date_of_birth     DateTime?
  gender            String?
  emergency_contact Json?
  address           String?
  province          String?
  city              String?
  gps_lat           Float?
  gps_lng           Float?
  onboarding_completed Boolean @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("driver_profiles")
}

model DriverPhoto {
  id                String    @id @default(uuid())
  driver_id         String    @unique
  driver            Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  profile_photo     String?
  selfie            String?
  vehicle_front     String?
  vehicle_back      String?
  vehicle_left      String?
  vehicle_right     String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("driver_photos")
}

model DriverDocuments {
  id                    String    @id @default(uuid())
  driver_id             String    @unique
  driver                Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  govt_id               String?
  license_front         String?
  license_back          String?
  police_clearance      String?
  medical_certificate   String?
  proof_of_address      String?
  vehicle_registration  String?
  insurance             String?
  roadworthy_certificate String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("driver_documents")
}

model DriverVehicle {
  id                  String    @id @default(uuid())
  driver_id           String    @unique
  driver              Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  vehicle_type        String?
  registration_number String?
  vin                 String?
  capacity            Float?
  manufacturer        String?
  model               String?
  year                Int?
  insurance           String?
  roadworthy          String?
  license_disc        String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("driver_vehicles")
}

model DriverKYC {
  id                      String    @id @default(uuid())
  driver_id               String    @unique
  driver                  Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  national_id             String?
  license_number          String?
  license_expiry          DateTime?
  selfie_verified         Boolean   @default(false)
  phone_verified          Boolean   @default(false)
  gps_enabled             Boolean   @default(false)
  terms_accepted          Boolean   @default(false)
  training_completed      Boolean   @default(false)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@map("driver_kyc")
}

model DriverApproval {
  id                    String    @id @default(uuid())
  driver_id             String    @unique
  driver                Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  approved_by_id        String?
  approved_by           User?     @relation("ApprovedByUser", fields: [approved_by_id], references: [id])
  rejection_reason      String?
  suspension_reason     String?
  requested_documents   String?   @db.Text
  approved_at           DateTime?
  rejected_at           DateTime?
  suspended_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("driver_approvals")
}

model DriverStatusHistory {
  id              String    @id @default(uuid())
  driver_id       String
  driver          Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  old_status      String?
  new_status      String
  changed_by_id   String?
  changed_by      User?     @relation("StatusChangedByUser", fields: [changed_by_id], references: [id])
  change_reason   String?
  created_at      DateTime  @default(now())

  @@map("driver_status_history")
}