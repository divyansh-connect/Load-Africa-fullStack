datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
  DRIVER
  FLEET_OWNER
  PLANT_OWNER
  BROKER
}

enum BookingStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTE_PREPARED
  CUSTOMER_ACCEPTED
  BOOKING_CONFIRMED
  DRIVER_SEARCHING
  DRIVER_APPLIED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED_PICKUP
  PICKUP_SCHEDULED
  PICKUP_ARRIVED
  LOADING
  PICKED_UP
  IN_TRANSIT
  ARRIVED_DESTINATION
  DELIVERED
  POD_UPLOADED
  POD_VERIFIED
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
  FAILED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum CommissionType {
  PLATFORM_FEE
  BROKER_FEE
  REFERRAL
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ==========================================
// USERS & ROLES
// ==========================================

model User {
  id          String    @id @default(uuid())
  uuid        String    @unique @default(uuid())
  email       String    @unique
  password    String
  role        UserRole
  status      String    @default("ACTIVE")
  is_verified Boolean   @default(false)
  last_login  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  // Relations
  customer    Customer?
  driver      Driver?
  fleet_owner FleetOwner?
  plant_owner PlantOwner?
  broker      Broker?
  admin       Admin?
  wallets     Wallet[]
  audit_logs  ActivityLog[]

  @@map("users")
}

model Customer {
  id           String  @id @default(uuid())
  user_id      String  @unique
  user         User    @relation(fields: [user_id], references: [id])
  company_name String?
  tax_number   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  bookings Booking[]
  invoices Invoice[]

  @@map("customers")
}

model Driver {
  id          String  @id @default(uuid())
  user_id     String  @unique
  user        User    @relation(fields: [user_id], references: [id])
  status      String  @default("AVAILABLE")
  license     String? @unique
  pdp         String?
  id_document String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  applications DriverApplication[]
  assignments  BookingAssignment[]

  @@map("drivers")
}

model FleetOwner {
  id           String  @id @default(uuid())
  user_id      String  @unique
  user         User    @relation(fields: [user_id], references: [id])
  company_name String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  vehicles    Vehicle[]
  assignments BookingAssignment[]

  @@map("fleet_owners")
}

model PlantOwner {
  id           String  @id @default(uuid())
  user_id      String  @unique
  user         User    @relation(fields: [user_id], references: [id])
  company_name String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("plant_owners")
}

model Broker {
  id           String  @id @default(uuid())
  user_id      String  @unique
  user         User    @relation(fields: [user_id], references: [id])
  company_name String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  assignments BookingAssignment[]

  @@map("brokers")
}

model Admin {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("admins")
}

// ==========================================
// VEHICLES
// ==========================================

model VehicleCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  vehicles Vehicle[]

  @@map("vehicle_categories")
}

model Vehicle {
  id             String          @id @default(uuid())
  fleet_owner_id String
  fleet_owner    FleetOwner      @relation(fields: [fleet_owner_id], references: [id])
  category_id    String
  category       VehicleCategory @relation(fields: [category_id], references: [id])

  registration_number String @unique
  vehicle_type        String
  capacity            Float?
  status              String @default("AVAILABLE")

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  assignments BookingAssignment[]

  @@map("vehicles")
}

// ==========================================
// BOOKINGS & QUOTES
// ==========================================

model Booking {
  id String @id @default(uuid())

  // Optional for Guests
  customer_id   String?
  customer      Customer? @relation(fields: [customer_id], references: [id])
  guest_email   String?
  guest_phone   String?
  guest_company String?

  // Step 1: Cargo
  cargo_name     String
  cargo_category String
  description    String? @db.Text
  weight         Float
  volume         Float?
  quantity       Int?

  // Step 2 & 3: Logistics
  pickup_address      String
  pickup_coords_lat   Float?
  pickup_coords_lng   Float?
  pickup_date         DateTime
  pickup_contact      String?
  pickup_instructions String?  @db.Text

  delivery_address      String
  delivery_coords_lat   Float?
  delivery_coords_lng   Float?
  delivery_date         DateTime
  delivery_contact      String?
  delivery_instructions String?  @db.Text

  // Step 4: Vehicle requested
  requested_vehicle  String?
  estimated_distance Float?

  status BookingStatus @default(DRAFT)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  requirements BookingRequirement[]
  documents    BookingDocument[]
  quotes       Quote[]
  applications DriverApplication[]
  assignments  BookingAssignment[]
  trackings    TrackingHistory[]
  invoices     Invoice[]

  @@index([status])
  @@map("bookings")
}

model BookingRequirement {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])
  tag        String // e.g., "INSURANCE", "FRAGILE", "HELPERS_REQUIRED"
  value      String? // Optional associated value (e.g., "2" helpers)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("booking_requirements")
}

model BookingDocument {
  id            String  @id @default(uuid())
  booking_id    String
  booking       Booking @relation(fields: [booking_id], references: [id])
  document_type String // INVOICE, PACKING_LIST, IMAGE, POD
  file_url      String
  uploaded_by   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("booking_documents")
}

model Quote {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])

  distance_cost     Decimal @default(0) @db.Decimal(10, 2)
  vehicle_rate      Decimal @default(0) @db.Decimal(10, 2)
  weight_charges    Decimal @default(0) @db.Decimal(10, 2)
  fuel_charges      Decimal @default(0) @db.Decimal(10, 2)
  insurance_charges Decimal @default(0) @db.Decimal(10, 2)
  hazard_charge     Decimal @default(0) @db.Decimal(10, 2)
  platform_fee      Decimal @default(0) @db.Decimal(10, 2)
  broker_fee        Decimal @default(0) @db.Decimal(10, 2)
  tax               Decimal @default(0) @db.Decimal(10, 2)
  discount          Decimal @default(0) @db.Decimal(10, 2)
  grand_total       Decimal @db.Decimal(10, 2)

  status      QuoteStatus @default(DRAFT)
  valid_until DateTime?
  prepared_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("quotes")
}

model BookingAssignment {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])

  driver_id      String?
  driver         Driver?     @relation(fields: [driver_id], references: [id])
  fleet_owner_id String?
  fleet_owner    FleetOwner? @relation(fields: [fleet_owner_id], references: [id])
  broker_id      String?
  broker         Broker?     @relation(fields: [broker_id], references: [id])
  vehicle_id     String?
  vehicle        Vehicle?    @relation(fields: [vehicle_id], references: [id])

  status      String  @default("ACTIVE")
  assigned_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("booking_assignments")
}

// ==========================================
// INVOICING & PAYMENTS
// ==========================================

model Invoice {
  id          String   @id @default(uuid())
  invoice_no  String   @unique
  booking_id  String
  booking     Booking  @relation(fields: [booking_id], references: [id])
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  amount       Decimal       @db.Decimal(10, 2)
  tax_amount   Decimal       @db.Decimal(10, 2)
  total_amount Decimal       @db.Decimal(10, 2)
  due_date     DateTime?
  status       InvoiceStatus @default(DRAFT)
  file_url     String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id         String  @id @default(uuid())
  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id])

  amount         Decimal       @db.Decimal(10, 2)
  payment_method String? // CARD, EFT, CASH
  transaction_id String?       @unique
  status         PaymentStatus @default(PENDING)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("payments")
}

// ==========================================
// WALLETS & COMMISSIONS
// ==========================================

model Wallet {
  id      String @id @default(uuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  balance         Decimal @default(0) @db.Decimal(10, 2)
  pending_balance Decimal @default(0) @db.Decimal(10, 2)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id        String @id @default(uuid())
  wallet_id String
  wallet    Wallet @relation(fields: [wallet_id], references: [id])

  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  description  String?
  reference_id String? // Can link to Booking, Payment, Commission etc.
  status       String          @default("COMPLETED")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("wallet_transactions")
}

model Commission {
  id                String @id @default(uuid())
  reference_type    String // e.g., "BOOKING"
  reference_id      String
  earned_by_user_id String // The Broker, Platform, or Fleet

  commission_type CommissionType
  amount          Decimal        @db.Decimal(10, 2)
  status          String         @default("PENDING")

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@map("commissions")
}

// ==========================================
// TRACKING & ACTIVITY
// ==========================================

model TrackingHistory {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])

  status     BookingStatus
  lat        Float?
  lng        Float?
  remarks    String?       @db.Text
  updated_by String? // User ID or "SYSTEM"

  timestamp DateTime @default(now())

  @@map("tracking_history")
}

model ActivityLog {
  id      String  @id @default(uuid())
  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  action      String
  description String? @db.Text
  ip_address  String?

  created_at DateTime @default(now())

  @@map("activity_logs")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id              String  @id @default(uuid())
  recipient_id    String? // Optional if sent to guest (email/phone)
  recipient_email String?
  recipient_phone String?

  type    NotificationType
  title   String?
  content String             @db.Text
  status  NotificationStatus @default(PENDING)

  error_message String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("notifications")
}

model DriverApplication {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id])
  driver_id  String
  driver     Driver   @relation(fields: [driver_id], references: [id])
  status     String   @default("APPLIED")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("driver_applications")
}
